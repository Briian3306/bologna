---
const navLinkClass =
  'nav-link block py-2 px-3 md:p-0 text-barley-corn-800 rounded hover:bg-barley-corn-200 md:hover:bg-transparent md:hover:text-barley-corn-600 border-b-2 border-transparent hover:border-barley-corn-600 transition-colors';
---
<nav class="border-gray-200 fixed top-0 left-0 right-0 z-[10]">
  <div class="max-w-screen-xl flex flex-wrap items-center justify-end mx-auto p-4">
    <div class="flex md:order-2 space-x-3 md:space-x-0 rtl:space-x-reverse">
      <button
        type="button"
        onclick="scrollToSection(event, 'contacto')"
        class="text-white bg-primary hover:bg-secondary focus:ring-4 focus:outline-none font-medium rounded-lg text-sm px-4 py-2 text-center"
      >
        Contacto
      </button>
      <button
        data-collapse-toggle="navbar-cta"
        type="button"
        class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-barley-corn-700 rounded-lg md:hidden hover:bg-barley-corn-300 focus:outline-none focus:ring-2 focus:ring-barley-corn-400"
        aria-controls="navbar-cta"
        aria-expanded="false"
        id="navbar-toggle"
        onclick="toggleMenu()"
      >
        <span class="sr-only">Abrir menú</span>
        <svg
          class="w-5 h-5"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 17 14"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M1 1h15M1 7h15M1 13h15"
          ></path>
        </svg>
      </button>
    </div>
    <div
      class="items-center justify-between hidden basis-full w-full order-last md:order-1 md:flex md:basis-auto md:w-auto"
      id="navbar-cta"
    >
      <ul
        class="flex flex-col font-medium w-full gap-1 p-4 mt-2 bg-barley-corn-50/95 backdrop-blur-md border border-barley-corn-200 rounded-lg shadow-sm md:flex-row md:items-center md:gap-0 md:p-0 md:mt-0 md:bg-transparent md:backdrop-blur-none md:border-0 md:shadow-none md:space-x-8 rtl:space-x-reverse"
      >
        <li>
          <a
            href="#home"
            class={navLinkClass}
            aria-current="page"
            onclick="scrollToSection(event, 'home')"
          >
            Home
          </a>
        </li>
        <li>
          <a
            href="#actividades"
            class={navLinkClass}
            onclick="scrollToSection(event, 'actividades')"
          >
            Actividades
          </a>
        </li>
        <li>
          <a
            href="#quien-soy"
            class={navLinkClass}
            onclick="scrollToSection(event, 'quien-soy')"
          >
            Quién soy
          </a>
        </li>
        <li>
          <a
            href="#sobre-mi"
            class={navLinkClass}
            onclick="scrollToSection(event, 'sobre-mi')"
          >
            Sobre mi
          </a>
        </li>
        <li>
          <a
            href="#prensa"
            class={navLinkClass}
            onclick="scrollToSection(event, 'prensa')"
          >
            Prensa
          </a>
        </li>
        <li>
          <a
            href="#bologna"
            class={`${navLinkClass} md:mr-4`}
            onclick="scrollToSection(event, 'bologna')"
          >
            Bologna
          </a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<script is:inline>
  const ACTIVE_LINK_CLASSES = ['border-barley-corn-600', 'text-barley-corn-700', 'font-semibold'];

  function getNavOffset() {
    const nav = document.querySelector('nav');
    return nav ? nav.offsetHeight : 80;
  }

  function closeMenu() {
    const navbar = document.getElementById('navbar-cta');
    const toggle = document.getElementById('navbar-toggle');
    if (navbar) navbar.classList.add('hidden');
    if (toggle) toggle.setAttribute('aria-expanded', 'false');
  }

  function scrollToSection(event, sectionId) {
    event.preventDefault();
    closeMenu();
    const section = document.getElementById(sectionId);
    if (!section) return;
    const offset = getNavOffset();
    const sectionPosition = section.getBoundingClientRect().top + window.scrollY - offset;
    window.scrollTo({ top: sectionPosition, behavior: 'smooth' });
  }

  function toggleMenu() {
    const navbar = document.getElementById('navbar-cta');
    const toggle = document.getElementById('navbar-toggle');
    if (!navbar || !toggle) return;
    const isHidden = navbar.classList.contains('hidden');
    navbar.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
  }

  document.addEventListener('DOMContentLoaded', () => {
    const sections = document.querySelectorAll('section');
    const navLinks = document.querySelectorAll('nav a.nav-link');

    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          navLinks.forEach(link => {
            link.classList.remove(...ACTIVE_LINK_CLASSES);
            if (link.getAttribute('href') === `#${entry.target.id}`) {
              link.classList.add(...ACTIVE_LINK_CLASSES);
            }
          });
        }
      });
    }, {
      threshold: 0.5,
      rootMargin: `-${getNavOffset()}px 0px 0px 0px`
    });

    sections.forEach(section => {
      observer.observe(section);
    });
  });
</script>

<style>
  		nav {
		  background-color: rgba(248, 247, 238, 0.8);
		  backdrop-filter: blur(10px);
		}
    a {
      cursor: pointer;
    }
</style>
