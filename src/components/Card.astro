---
interface Props {
    title?: string;
    subtitle?: string;
    texts: string[];
    url_image?: string;
    imagePosition?: 'left' | 'right';
    border?: boolean;
    buttonTitle?: string;
    buttonHref?: string;
}

const { title, subtitle, texts, url_image, imagePosition = 'right', border = true, buttonTitle, buttonHref } = Astro.props;
const contentWidthClass = url_image ? 'w-full md:w-2/5 lg:w-3/5' : 'w-full';
---

<div class={`fade-in-up flex bg-barley-corn-50 sm:flex-col md:flex-row lg:flex-row gap-4 items-stretch transition-transform min-h-[550px] ${border ? 'border-l-4 border-barley-corn-400 pl-4' : ''} ${imagePosition === 'left' ? 'md:flex-row-reverse' : ''}`}>
    <div class={`${contentWidthClass} flex flex-col`}>
        {title && <h2 class="font-bold mb-2 text-barley-corn-200 lg:text-6xl md:text-4xl sm:text-3xl">{title}</h2>}
        {subtitle && <h3 class="font-bold mb-3 lg:text-4xl md:text-2xl sm:text-2xl">{subtitle}</h3>}
        {texts.map((text) => (
            <p class="font-normal mb-3 lg:text-2xl md:text-xl sm:text-xs">{text}</p>
        ))}
        {buttonTitle && buttonHref && (
            <a href={buttonHref} target="_blank" rel="noopener noreferrer" class="mt-4 inline-block max-w-[300px] bg-barley-corn-600 text-white py-2 px-4 rounded hover:bg-barley-corn-700 transition-colors duration-300">
                {buttonTitle}
            </a>
        )}
    </div>
    { url_image  && (
    <img src={url_image} alt="Formación" loading="lazy" class="object-cover lg:max-h-[600px] md:max-h-[500px] sm:max-h-[400px] lg:object-center md:object-center sm:object-top w-full h-full md:w-3/5 lg:w-2/5 transition-all duration-300 ease-in-out hover:brightness-75 cursor-pointer" />
    )}
</div>
<style>

</style>

