---
import Card from "../components/Card.astro";
import Title from "../components/Title.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Welcome to Astro.">
	<main class="flex flex-col mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 gap-10 md:gap-16 lg:gap-20">

		<section id="home" class="h-[calc(100svh-5rem)] w-full flex flex-col mb-6">
			<div class="flex-1 flex justify-center min-h-0">
				<div class="w-full h-full flex flex-nowrap justify-center items-stretch flex-col-reverse lg:flex-row gap-2">
					<div class="flex-1 flex flex-col gap-4 justify-center min-h-0">
						<header>
							<h1 class="text-5xl lg:text-7xl font-bold animate-fade-in">Juan Rinaldi</h1>
							<h2 class="text-5xl lg:text-7xl font-bold mb-3 animate-fade-in animate-delay-200">Grupo Bologna</h2>
						</header>
						<section>
							<article>
								<p class="text-xl lg:text-2xl mb-2 pr-6 text-wrap">
								Abogado por la Facultad de Derecho y Ciencias Sociales de la Universidad de Morón (1987).
								</p>
								<p class="text-xl lg:text-2xl pr-6 text-wrap">
								Especialista en Derecho, Política y Criminología en el Derecho del Trabajo por la Universidad de Salamanca (1998 y 1999).
								</p>
							</article>
						</section>
					</div>
					<div class="flex-1 h-1/4 lg:h-3/4 my-auto flex items-center justify-center min-h-0">
						<div class="relative w-full h-full max-w-full max-h-full animate-bouncing">
							<img
								loading="lazy"
								class="absolute inset-0 max-h-full max-w-full w-auto h-auto object-contain m-auto"
								src="./images/juan--rinaldi.jpg"
								alt="Juan Rinaldi"
							/>
						</div>
					</div>
				</div>
			</div>
			<div class="flex-none">
				<p class="bg-barley-corn-50 font-bold text-center text-xs lg:text-xl py-3 px-2">
					36 años de experiencia en el ámbito laboral, indagando
					incansablemente la aplicación de las normas y en ejercicio
					de mi profesión como abogado.
				</p>
			</div>
		</section>

		<section id="actividades" class="w-full bg-primary text-white flex justify-center items-center rounded-lg">
			<div class="p-6 md:p-10 flex flex-col w-full">
				<h1 class="font-bold mb-4 text-left text-3xl sm:text-4xl md:text-5xl lg:text-7xl">
					Actividades Destacadas
				</h1>
				<ul class="list-none divide-y">
					<li class="font-bold text-lg md:text-2xl lg:text-4xl py-3 md:py-6 lg:py-8">
						01 - Director en el Instituto de Derecho Social y del
						Trabajo
					</li>
					<li class="font-bold text-lg md:text-2xl lg:text-4xl py-3 md:py-6 lg:py-8">
						02 - Representante Argentino ante la OIT en las
						Conferencias Anuales por la Asociación ADEBA
					</li>
					<li class="font-bold text-lg md:text-2xl lg:text-4xl py-3 md:py-6 lg:py-8">
						03 - Director académico de la Diplomatura en Relaciones
						Laborales en la Universidad de Belgrano
					</li>
					<li class="font-bold text-lg md:text-2xl lg:text-4xl py-3 md:py-6 lg:py-8">
						04 - Profesor invitado estable en Facultad de Ciencias Económicas de la UBA
					</li>
				</ul>
			</div>
		</section>

		<section id="quien-soy" class="animation">
			<h1 class="font-bold text-balance text-center px-2 text-2xl sm:text-4xl md:text-5xl lg:text-6xl">
				"Soy especialista en Análisis Laboral"
			</h1>
		</section>

		<section class="w-full flex flex-col items-center">
			<div class="w-full text-white flex flex-col md:flex-row flex-nowrap gap-6 md:gap-10 justify-center items-stretch">
				<div class="flex-1 bg-barley-corn-400 p-6 md:p-8 rounded-lg group zoom-in">
					<h3 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-3 relative transition-all duration-300 group-hover:text-barley-corn-800">
						Formación
						<span class="absolute bottom-0 left-0 w-12 h-[1px] bg-barley-corn-800 transition-all duration-300 group-hover:w-full"></span>
					</h3>
					<ul class="list-disc flex flex-col gap-4 items-stretch pl-6">
						<li class="text-base md:text-lg lg:text-2xl">
							Curso de Especialización para Expertos
							Latinoamericanos en Relaciones Laborales y Temas del
							Trabajo: Mercados de Trabajo y Políticas de Empleo,
							por la Universidad de Bologna (2001).
						</li>
						<li class="text-base md:text-lg lg:text-2xl">
							Programa de Formación de Normas Internacionales del
							Trabajo en el Centro Internacional de Formación
							Turín perteneciente a la OIT (2002 y 2016).
						</li>
						<li class="text-base md:text-lg lg:text-2xl">
							Normas Internacionales: Proyecto de Evaluación
							(Segunda Fase), en Turín/Ginebra (2003).
						</li>
					</ul>
				</div>

				<div class="flex-1 bg-barley-corn-400 p-6 md:p-8 rounded-lg group zoom-in">
					<h3 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-3 relative transition-all duration-300 group-hover:text-barley-corn-800">
						Experiencia
						<span class="absolute bottom-0 left-0 w-12 h-[1px] bg-barley-corn-800 transition-all duration-300 group-hover:w-full"></span>
					</h3>
					<ul class="list-disc flex flex-col gap-4 items-stretch pl-6">
						<li class="text-base md:text-lg lg:text-2xl">Asesor de la Constituyente reformadora de la Constitución Nacional y de la estatuyente porteña (1996)</li>
						<li class="text-base md:text-lg lg:text-2xl">Abogado en distintos gremios y apoderado del CGT hasta 2005.</li>
						<li class="text-base md:text-lg lg:text-2xl">Superintendente de Salud en 2009</li>
						<li class="text-base md:text-lg lg:text-2xl">Apoderado de Banco Macro en 2020</li>
						<li class="text-base md:text-lg lg:text-2xl">Asesor de Recursos humanos en CGC</li>
						<li class="text-base md:text-lg lg:text-2xl">Asesor del Directorio de Edenor desde 2023
						</li>
					</ul>
				</div>
			</div>
		</section>

		<section id="sobre-mi" class="w-full">
			<h1 class="font-bold text-barley-corn-900 mb-4 text-3xl sm:text-4xl md:text-5xl lg:text-7xl">Sobre mi</h1>
			<Card 
				texts={[
					"Abogado por la Facultad de Derecho y Ciencias Sociales de la Universidad de Morón (1987).",
					"Especialista en Derecho, Política y Criminología en Derecho del Trabajo por la Universidad de Salamanca (1998 y 1999).",
					"En 2001 tuve el honor de participar en el dictado de clases en la Universidad de Bologna, en Italia, invitado por la misma Universidad.",
					"También representé a Argentina en Suiza, Ginebra, en su 111a Conferencia Anual por ser delegado de la OIT (Organización Internacional del Trabajo).",
					"Se abordaron temas muy importantes sobre la economía mundial, entre ellos: una transición justa hacia economías sostenibles e inclusivas, aprendizajes de calidad, y la protección de los trabajadores.",
					"Culminando en 2023 en un encuentro anual de Especialistas en Relaciones Laborales Grupo Bologna, Castilla - La Mancha, Turín, que se celebró en esta oportunidad en San Pablo, Brasil.",
					"He realizado diferentes cursos en esta Universidad, especializándome en Normas Internacionales del Trabajo, los cuales han sido muy enriquecedores para mi carrera, desempeñándome desde el año 1989, con 33 años de experiencia en el rubro."
				]}
				url_image="./images/sobre-mi.jpg" 
				border={false}
			/>
			<div class="fade-in-up grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4 mt-4">
				<img 
					src="./images/CGC-1.jpg" 
					alt="Evento en CGC con autoridades del sector laboral" 
					loading="lazy" 
					class="w-full h-48 md:h-64 lg:max-h-[400px] object-cover rounded-lg transition duration-300 hover:scale-[1.02]" 
				/>
				<img 
					src="./images/CGC-2.jpg" 
					alt="Reunión en CGC con directivos y funcionarios" 
					loading="lazy" 
					class="w-full h-48 md:h-64 lg:max-h-[400px] object-cover rounded-lg transition duration-300 hover:scale-[1.02]" 
				/>
				<img 
					src="./images/juan-rinaldi-uba.jpg" 
					alt="Juan Rinaldi en la Facultad de Ciencias Económicas de la UBA" 
					loading="lazy" 
					class="w-full h-48 md:h-64 lg:max-h-[400px] object-cover rounded-lg transition duration-300 hover:scale-[1.02]" 
				/>
				<img 
					src="./images/juan-rinaldi-uba-salon.jpg" 
					alt="Juan Rinaldi dictando clase en el salón de la UBA" 
					loading="lazy" 
					class="w-full h-48 md:h-64 lg:max-h-[400px] object-cover rounded-lg transition duration-300 hover:scale-[1.02]" 
				/>
			</div>
		</section>

		<section id="prensa" class="w-full">
			<div class="flex flex-col gap-12">
				<Card
					title="Cena en CGC"
					texts={[
						"Cena en CGC con el Secretario de Trabajo, el Jefe de Gabinete de la Secretaría del Trabajo y directivos de la empresa Dres. Fernandez y Daloe.",
					]}
					url_image="./images/cena.jpeg"
					imagePosition="right"
				/>
				<Card
					title="Representando Argentina"
					texts={[
						"OIT: Rinaldi representa a Argentina en la 111a. reunión de la Conferencia Internacional del Trabajo en Ginebra",
						"El Analista Laboral, el Dr. Juan Rinaldi, es delegado por la OIT (Organización Internacional del Trabajo) para representar a Argentina en Suiza, Ginebra, en su 111.a Conferencia Anual, que será llevada a cabo del 5 al 16 de junio de este año",
						"Habrá tanto delegados de trabajadores, empleadores y gobiernos de los 187 Estados Miembros de la OIT",
						"Los cuales abordarán temas muy importantes sobre la economía mundial, entre ellos: una transición justa hacia economías sostenibles e inclusivas, aprendizajes de calidad, y la protección de los trabajadores.",
					]}
					url_image="./images/card-1.jpg"
					imagePosition="left"
				/>
				<Card
					title="CURSO DE RELACIONES INDUSTRIALES"
					subtitle="Universidad de Bologna"
					texts={[
						"El Instituto de Derecho Social y del Trabajo, con la dirección del Dr. Juan Rinaldi y junto con la Universidad de Bologna – Italia con el Dr. Andrea Lassandari, organizan promover una formación especializada para reconocidos profesionales argentinos de la carrera de Derecho Laboral. Esto forma parte del conjunto de intercambios desarrollados entre ambas instituciones",
						"Esto intenta profundizar en nuevos enfoques que permitan abordar las transformaciones actuales que recorren hoy las relaciones sociales. En este aspecto busca vincular, desde una perspectiva interdisciplinaria, la multiplicidad de condiciones que a nivel global y local atraviesan este campo de trabajo, además del conjunto de categorías incluidas en él. Este curso se propone comprender, desde el ámbito del Derecho, las transformaciones profundas en los esquemas tradicionales que organizan y regulan las relaciones industriales en la actualidad",
					]}
					url_image="./images/card-2.jpg"
					imagePosition="right"
				/>
				<Card
					title="Reunion de los egresados de Bologna en la universidad de San Pablo celebrada este año"
					subtitle="Universidad de Bologna"
					texts={[
						"Desde 1988 se ha desarrollado con el auspicio de la Universidad de Bologna, Italia, la Organización Internacional del Trabajo y el Ministerio de Relaciones Exteriores de Italia, un curso para Expertos Latinoamericanos en Relaciones del Trabajo, que año a año ha ido formando especialistas provenientes de la sociología, la economía, el derecho, las ciencias políticas, la ingeniería, con actuación en el campo de las relaciones laborales.",
					]}
					url_image="./images/card-3.jpg"
					imagePosition="left"
				/>
				<Card
					title="Reforma Laboral 2024 en Argentina"
					subtitle="Claves y Reacciones ante una Transformación Histórica"
					texts={[
						"La nueva reforma laboral en Argentina, implementada en 2024, apunta a modernizar el mercado laboral con medidas como incentivos fiscales para reducir la informalidad (actualmente en 37%), la creación de un fondo de cese laboral financiado por empresas, y la regulación del teletrabajo, garantizando derechos como la desconexión digital y la igualdad de condiciones",
						"El gobierno asegura que estas reformas impulsarán la inversión y generarán empleo formal, pero enfrenta fuertes críticas de sindicatos, como la CGT, que argumentan que podrían precarizar el trabajo y afectar a las pymes. Además, la polémica Ley Antibloqueo, que limita las protestas sindicales, ha generado debates sobre el equilibrio entre derechos laborales y el crecimiento económico",
						"Expertos destacan que el éxito de la reforma dependerá de su implementación y del diálogo entre sectores, mientras comparan el modelo con experiencias similares en países como Chile y Colombia."
					]}
					buttonTitle="🔍 Descubre más sobre la reforma"
					buttonHref="https://www.infobae.com/opinion/2025/02/08/la-nueva-reforma-laboral-en-argentina-impactos-y-perspectivas-para-el-2025/"
					imagePosition="right"
				/>
				<Card
					title="Radiografía del empleo en Argentina"
					subtitle="El desafío de integrar a los trabajadores en un país con distintas realidades productivas"
					texts={[
						"Argentina necesita pensar el desarrollo, el empleo y las políticas productivas desde una perspectiva regional. El país presenta seis grandes realidades económicas —NOA, NEA, Cuyo, Pampeana, Patagonia y AMBA/CABA— con estructuras productivas, niveles salariales e indicadores laborales muy diferentes, que requieren estrategias específicas.",
						"En el NOA conviven sectores dinámicos como la minería del litio con elevados niveles de informalidad laboral. En el NEA persisten fuertes dificultades de inserción laboral para los jóvenes, especialmente las mujeres. El Conurbano Bonaerense registra los mayores niveles de desocupación, mientras que la Patagonia concentra algunos de los salarios privados más altos del país.",
						"Las brechas de infraestructura y los costos logísticos afectan la competitividad regional y pueden representar una porción significativa del valor de los productos en las economías alejadas de los principales centros de consumo. El desafío es diseñar políticas de desarrollo, empleo e inversión adaptadas a las características de cada región para lograr un crecimiento más equilibrado e inclusivo.",
					]}
					buttonTitle="📰 Leer artículo completo"
					buttonHref="https://www.infobae.com/opinion/2026/06/19/radiografia-del-empleo-en-argentina-el-desafio-de-integrar-a-los-trabajadores-en-un-pais-con-distintas-realidades-productivas/"
					imagePosition="left"
				/>
			</div>
			<div class="mt-12">
				<h2 class="font-bold text-barley-corn-900 mb-6 text-2xl md:text-4xl lg:text-5xl leading-tight text-balance">Presentación de libro "Violencia de Género en el Trabajo" por editorial Astrea</h2>
				<div class="fade-in-up grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
					<img 
						src="./images/charla_rinaldi.jpeg" 
						alt="Charla de presentación del libro Violencia de Género en el Trabajo" 
						loading="lazy" 
						class="w-full h-48 md:h-64 lg:max-h-[400px] object-cover rounded-lg transition duration-300 hover:scale-[1.02]" 
					/>
					<img 
						src="./images/charla_rinaldi (2).jpeg" 
						alt="Audiencia en la presentación del libro en Editorial Astrea" 
						loading="lazy" 
						class="w-full h-48 md:h-64 lg:max-h-[400px] object-cover rounded-lg transition duration-300 hover:scale-[1.02]" 
					/>
					<img 
						src="./images/charla_rinaldi (3).jpeg" 
						alt="Juan Rinaldi durante la charla de presentación del libro" 
						loading="lazy" 
						class="w-full h-48 md:h-64 lg:max-h-[400px] object-cover rounded-lg transition duration-300 hover:scale-[1.02]" 
					/>
				</div>
			</div>
			<div class="mt-12">
				<h2 class="font-bold text-barley-corn-900 mb-6 text-2xl md:text-4xl lg:text-5xl leading-tight text-balance">Presentación de libro "La nueva realidad del Derecho Laboral" por Editorial Astrea</h2>
				<div class="fade-in-up flex flex-col md:flex-row gap-4">
					<div class="flex-1 flex justify-center">
						<img
							src="./images/libro-nueva-realidad.jpeg"
							alt="La nueva realidad del Derecho Laboral - Dr. Juan Rinaldi"
							loading="lazy"
							class="w-full h-48 md:h-64 lg:max-h-[400px] object-cover rounded-lg transition duration-300 hover:scale-[1.02]"
						/>
					</div>
					<div class="flex-1 flex flex-col justify-center">
						<p class="text-base md:text-lg lg:text-2xl text-black">
							La nueva realidad del Derecho Laboral es la segunda obra del Dr. Juan Rinaldi, publicada por Editorial Astrea. El libro ofrece un análisis integral de la Ley 27.742 (Bases y Puntos de Partida) y sus implicancias en el derecho laboral, incorporando además el estudio del RIGI, la ley antibloqueo y la reforma del Estado, con una mirada profunda sobre los desafíos actuales del sector productivo y la legislación vigente.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section id="bologna" class="w-full">
			<Title title="Universidad de Bologna"/>
			<div class="flex flex-col md:flex-row gap-4 items-center md:items-start">
				<p class="flex-1 bg-barley-corn-50 font-normal mb-3 text-base md:text-lg lg:text-2xl p-4 md:p-0">Desde 1988 se ha desarrollado con el auspicio de la Universidad de Bologna, Italia, la Organización Internacional del Trabajo y el Ministerio de Relaciones Exteriores de Italia, un Curso para Expertos Latinoamericanos en Relaciones del Trabajo, que año a año ha ido formando especialistas provenientes de la sociología, la economía, el derecho, las ciencias políticas, la inla ingeniería, con actuación en el campo de las relaciones laborales</p>
				<img loading="lazy" src="./images/logo-bologna.jpg" alt="Logo de la Universidad de Bologna" class="w-40 h-40 md:w-52 md:h-52 lg:w-[300px] lg:h-[300px] object-contain shrink-0" />
			</div>
		</section>

		<section id="quienes-somos" class="w-full">
			<Title title="¿Quienes somos?"/>
			<div class="flex flex-col md:flex-row gap-4 bg-barley-corn-50 fade-in-up p-4 md:p-6">
				<div class="flex-1">
					<p class="mb-3 text-base md:text-lg lg:text-2xl">La Asociación de Especialistas en Relaciones Laborales Ex Becarios de la Universidad de Bologna, Centro Internacional de Formación de la OIT y de la Universidad de Castilla - La Mancha (Sección Argentina), conocida como "Grupo Bologna", fue constituida en el mes de mayo del año 2007 bajo la ﬁgura de asociación civil sin ﬁnes de lucro, con el propósito de nuclear a los participantes ex becarios del "Curso para expertos latinoamericanos en relaciones del trabajo"</p>
					<p class="mb-3 text-base md:text-lg lg:text-2xl">Tenemos como objeto promover, fomentar y difundir las disciplinas relacionadas con el trabajo, las relaciones laborales y las que resulten científica y técnicamente aﬁnes, con una especial vocación triparta (trabajadores, empleadores y Estado)</p>
					<p class="mb-3 text-base md:text-lg lg:text-2xl">Nuestra Asociación, en sus actividades en Argentina, ha propiciado Encuentros y Seminarios con especialistas de alto nivel, a la vez que ha organizado y dirigido Cursos de Capacitación para jóvenes pertenecientes al área de las relaciones laborales. Siempre con miras a formar esa masa crítica de pensamiento y acción que, en muchos casos, alimenta de participantes a los cursos que se realizan año a año en la sede actual del curso en la Universidad de Casilla La Mancha, Toledo, España</p>
					<p class="mb-3 text-base md:text-lg lg:text-2xl">Se caracteriza por una convocatoria amplia y dirigida a asegurar la interdisciplinariedad de la membresía tanto al Curso de Expertos, como a la integración de nuestra Asociación que recibe como socios y socias a los ex becarios del Curso</p>
					<p class="mb-3 text-base md:text-lg lg:text-2xl">Por tales motivos, orgullosamente contamos entre nuestra nómina de socias y socios con destacados miembros del mundo del Trabajo, referentes de los actores sociales, funcionarios/as de gobierno, asesores de sindicatos y de las organizaciones empresarias; todas y todos con amplia trayectoria académica y profesional. Incluso, muchos/as de ellos/as son o han sido consultores de la OIT o han integrado la Organización en sus órganos de gestión o en áreas técnicas.</p>
				</div>
				<div class="flex flex-row md:flex-col gap-2 md:w-2/5 lg:w-1/4 shrink-0">
					<img loading="lazy" src="./images/quienes-somos-1.jpg" alt="Miembros del Grupo Bologna en un encuentro" class="object-cover w-full h-52 md:h-80 lg:h-96 object-center transition-all duration-300 ease-in-out hover:brightness-75 rounded-lg" />
					<img loading="lazy" src="./images/quienes-somos-2.jpeg" alt="Seminario del Grupo Bologna con especialistas en relaciones laborales" class="object-cover w-full h-52 md:h-80 lg:h-96 object-top transition-all duration-300 ease-in-out hover:brightness-75 rounded-lg" />
				</div>
			</div>
		</section>

		<section id="diplomas" class="w-full">
			<Title title="Diplomas"/>
			<div class="flex flex-col align-middle justify-center">
				<div class="grid grid-cols-2 md:grid-cols-4 gap-4 justify-items-center mb-4 fade-in-up">
					<a href="./images/diploma-1.jpg" target="_blank" rel="noopener noreferrer" class="transition-all duration-300 hover:scale-105 focus:outline-none focus:ring-2 focus:ring-barley-corn-600 focus:ring-offset-2 rounded">
						<img alt="Diploma de la Universidad de Bologna" loading="lazy" class="w-full max-w-[220px] md:max-w-xs object-cover border-4 md:border-8 border-barley-corn-400" src="./images/diploma-1.jpg">
					</a>
					<a href="./images/certificado.jpg" target="_blank" rel="noopener noreferrer" class="transition-all duration-300 hover:scale-105 focus:outline-none focus:ring-2 focus:ring-barley-corn-600 focus:ring-offset-2 rounded">
						<img alt="Certificado de formación en relaciones laborales" loading="lazy" class="w-full max-w-[220px] md:max-w-xs object-cover border-4 md:border-8 border-barley-corn-400" src="./images/certificado.jpg">
					</a>
					<a href="https://credentials.itcilo.org/a91e43c5-f471-4e87-b85e-7db00bf82fce?utm_source=whatsapp&utm_medium=social" target="_blank" rel="noopener noreferrer" class="transition-all duration-300 hover:scale-105 focus:outline-none focus:ring-2 focus:ring-barley-corn-600 focus:ring-offset-2 rounded">
						<img alt="Certificado de participación OIT - MOOC debida diligencia derechos humanos" loading="lazy" class="w-full max-w-[220px] md:max-w-xs object-cover border-4 md:border-8 border-barley-corn-400" src="./images/certificado-participacion.png">
					</a>
