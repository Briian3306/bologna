---
interface Props {
    title?: string;
    subtitle?: string;
    texts: string[];
    url_image?: string;
    imagePosition?: 'left' | 'right';
    border?: boolean;
    buttonTitle?: string;
    buttonHref?: string;
}

const { title, subtitle, texts, url_image, imagePosition = 'right', border = true, buttonTitle, buttonHref } = Astro.props;
const contentWidthClass = url_image ? 'w-full md:w-3/5 lg:w-3/5' : 'w-full';
const imageAlt = title || 'Juan Rinaldi';
---

<div class={`fade-in-up flex flex-col md:flex-row bg-barley-corn-50 gap-4 md:gap-6 items-stretch transition-transform min-h-0 md:min-h-[480px] lg:min-h-[550px] p-4 md:p-6 ${border ? 'border-l-4 border-barley-corn-400' : ''} ${imagePosition === 'left' ? 'md:flex-row-reverse' : ''}`}>
    <div class={`${contentWidthClass} flex flex-col`}>
        {title && <h2 class="font-bold mb-2 text-barley-corn-800 text-2xl md:text-4xl lg:text-5xl">{title}</h2>}
        {subtitle && <h3 class="font-bold mb-3 text-lg md:text-2xl lg:text-3xl">{subtitle}</h3>}
        {texts.map((text) => (
            <p class="font-normal mb-3 text-base md:text-lg lg:text-xl">{text}</p>
        ))}
        {buttonTitle && buttonHref && (
            <a href={buttonHref} target="_blank" rel="noopener noreferrer" class="mt-4 inline-block w-full md:w-auto md:max-w-[300px] bg-barley-corn-600 text-white py-3 px-4 rounded hover:bg-barley-corn-700 transition-colors duration-300 focus:outline-none focus:ring-2 focus:ring-barley-corn-700">
                {buttonTitle}
            </a>
        )}
    </div>
    { url_image  && (
    <img src={url_image} alt={imageAlt} loading="lazy" class="object-cover rounded-md w-full md:w-2/5 lg:w-2/5 max-h-[240px] sm:max-h-[320px] md:max-h-[500px] lg:max-h-[600px] transition-all duration-300 ease-in-out hover:brightness-95" />
    )}
</div>
<style>

</style>

